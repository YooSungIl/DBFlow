#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"

  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$DIR/$SOURCE"
  fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
APP_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
JAVA_HOME="$APP_HOME/runtime/java17/Contents/Home"

if [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "DBFlow Java Runtime을 찾을 수 없습니다."
  echo "PATH: $JAVA_HOME"
  exit 1
fi

shopt -s nullglob
JAR_FILES=("$APP_HOME"/lib/dbflow-*.jar)
shopt -u nullglob

if [ "${#JAR_FILES[@]}" -ne 1 ]; then
  echo "DBFlow 실행 JAR는 하나만 존재해야 합니다."
  echo "PATH: $APP_HOME/lib"
  exit 1
fi

exec "$JAVA_HOME/bin/java" -jar "${JAR_FILES[0]}" "$@"
